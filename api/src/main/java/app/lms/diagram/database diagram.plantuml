@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class block_progress {
   attempts: int(11)
   completed: bit(1)
   block_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   user_id: bigint(20)
   id: bigint(20)
}
class blocks {
   position: int(11)
   created_at: datetime(6)
   lesson_id: bigint(20)
   question_id: bigint(20)
   updated_at: datetime(6)
   content: text
   title: varchar(255)
   id: bigint(20)
}
class chapters {
   position: int(11)
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   title: varchar(255)
   id: bigint(20)
}
class comments {
   author_id: bigint(20)
   created_at: datetime(6)
   parent_id: bigint(20)
   post_id: bigint(20)
   updated_at: datetime(6)
   content: text
   id: bigint(20)
}
class course_enrollments {
   progress_percentage: int(11)
   completed_at: datetime(6)
   course_id: bigint(20)
   enrolled_at: datetime(6)
   current_block_id: bigint(20)
   current_lesson_id: bigint(20)
   user_id: bigint(20)
   status: enum('active', 'banned', 'completed', 'dropped')
   id: bigint(20)
}
class course_faqs {
   position: int(11)
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   answer: text
   question: text
   id: bigint(20)
}
class course_media {
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   file_id: varchar(255)
   name: varchar(255)
   url: text
   type: enum('file', 'image', 'video')
   id: bigint(20)
}
class courses {
   created_at: datetime(6)
   organization_id: bigint(20)
   updated_at: datetime(6)
   cover_file_id: varchar(255)
   cover_url: varchar(255)
   description: varchar(255)
   slug: varchar(255)
   title: varchar(255)
   status: enum('draft', 'published')
   id: bigint(20)
}
class final_quiz_attempt_answer_options {
   attempt_answer_id: bigint(20)
   option_value: varchar(255)
}
class final_quiz_attempt_answers {
   correct: bit(1)
   correct_answer_index: int(11)
   selected_answer_index: int(11)
   attempt_id: bigint(20)
   created_at: datetime(6)
   source_question_id: bigint(20)
   updated_at: datetime(6)
   content: text
   id: bigint(20)
}
class final_quiz_attempts {
   completed: bit(1)
   score: int(11)
   total: int(11)
   course_id: bigint(20)
   created_at: datetime(6)
   quiz_id: bigint(20)
   updated_at: datetime(6)
   user_id: bigint(20)
   id: bigint(20)
}
class lessons {
   position: int(11)
   chapter_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   title: varchar(255)
   id: bigint(20)
}
class organization_invites {
   max_uses: int(11)
   used_count: int(11)
   accepted_at: datetime(6)
   created_at: datetime(6)
   expires_at: datetime(6)
   invited_by: bigint(20)
   organization_id: bigint(20)
   updated_at: datetime(6)
   user_id: bigint(20)
   token: varchar(255)
   role: enum('admin', 'owner', 'student')
   status: enum('accepted', 'cancelled', 'declined', 'expired', 'pending')
   id: bigint(20)
}
class organization_join_requests {
   created_at: datetime(6)
   organization_id: bigint(20)
   reviewed_at: datetime(6)
   reviewed_by_id: bigint(20)
   user_id: bigint(20)
   status: enum('accepted', 'cancelled', 'pending', 'rejected')
   id: bigint(20)
}
class organization_members {
   joined_at: datetime(6)
   organization_id: bigint(20)
   user_id: bigint(20)
   role: enum('admin', 'owner', 'student')
   id: bigint(20)
}
class organizations {
   created_at: datetime(6)
   owner_id: bigint(20)
   updated_at: datetime(6)
   description: varchar(255)
   image_file_id: varchar(255)
   image_url: varchar(255)
   name: varchar(255)
   slug: varchar(255)
   visibility: enum('private', 'public')
   id: bigint(20)
}
class post_likes {
   created_at: datetime(6)
   post_id: bigint(20)
   user_id: bigint(20)
   id: bigint(20)
}
class posts {
   author_id: bigint(20)
   comments_count: bigint(20)
   course_id: bigint(20)
   created_at: datetime(6)
   likes_count: bigint(20)
   organization_id: bigint(20)
   updated_at: datetime(6)
   title: varchar(500)
   content: varchar(255)
   id: bigint(20)
}
class practice_quiz_attempt_answer_options {
   attempt_answer_id: bigint(20)
   option_value: varchar(255)
}
class practice_quiz_attempt_answers {
   created_at: datetime(6)
   updated_at: datetime(6)
   content: text
   correct: bit(1)
   correct_answer_index: int(11)
   selected_answer_index: int(11)
   attempt_id: bigint(20)
   source_question_id: bigint(20)
   id: bigint(20)
}
class practice_quiz_attempts {
   created_at: datetime(6)
   updated_at: datetime(6)
   score: int(11)
   total: int(11)
   course_id: bigint(20)
   practice_quiz_id: bigint(20)
   user_id: bigint(20)
   id: bigint(20)
}
class practice_quiz_questions {
   question_id: bigint(20)
   practice_quiz_id: bigint(20)
   position: int(11)
}
class practice_quizzes {
   created_at: datetime(6)
   updated_at: datetime(6)
   description: text
   title: varchar(255)
   course_id: bigint(20)
   id: bigint(20)
}
class profiles {
   user_id: bigint(20)
   email: varchar(255)
   phone: varchar(255)
   university: varchar(255)
   id: bigint(20)
}
class question_options {
   question_id: bigint(20)
   option_value: varchar(255)
}
class questions {
   correct_answer_index: int(11)
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   content: text
   id: bigint(20)
}
class quiz_questions {
   question_id: bigint(20)
   quiz_id: bigint(20)
   position: int(11)
}
class quizzes {
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   title: varchar(255)
   id: bigint(20)
}
class random_quiz_attempt_question_options {
   attempt_question_id: bigint(20)
   option_value: varchar(255)
}
class random_quiz_attempt_questions {
   correct: bit(1)
   correct_answer_index: int(11)
   selected_answer_index: int(11)
   attempt_id: bigint(20)
   created_at: datetime(6)
   source_question_id: bigint(20)
   updated_at: datetime(6)
   content: text
   id: bigint(20)
}
class random_quiz_attempts {
   completed: bit(1)
   score: int(11)
   course_id: bigint(20)
   created_at: datetime(6)
   updated_at: datetime(6)
   user_id: bigint(20)
   id: bigint(20)
}
class users {
   name: varchar(255)
   picture: varchar(255)
   picture_file_id: varchar(255)
   telegram_id: varchar(255)
   id: bigint(20)
}
class xp_events {
   amount: int(11)
   created_at: datetime(6)
   reference_id: bigint(20)
   user_id: bigint(20)
   type: enum('course_enroll', 'daily_streak', 'lesson_complete', 'question_correct', 'quiz_complete')
   id: bigint(20)
}

block_progress                        -[#595959,plain]-^  blocks                               : "block_id:id"
block_progress                        -[#595959,plain]-^  users                                : "user_id:id"
blocks                                -[#595959,plain]-^  lessons                              : "lesson_id:id"
blocks                                -[#595959,plain]-^  questions                            : "question_id:id"
chapters                              -[#595959,plain]-^  courses                              : "course_id:id"
comments                              -[#595959,plain]-^  comments                             : "parent_id:id"
comments                              -[#595959,plain]-^  posts                                : "post_id:id"
comments                              -[#595959,plain]-^  users                                : "author_id:id"
course_enrollments                    -[#595959,plain]-^  blocks                               : "current_block_id:id"
course_enrollments                    -[#595959,plain]-^  courses                              : "course_id:id"
course_enrollments                    -[#595959,plain]-^  lessons                              : "current_lesson_id:id"
course_enrollments                    -[#595959,plain]-^  users                                : "user_id:id"
course_faqs                           -[#595959,plain]-^  courses                              : "course_id:id"
course_media                          -[#595959,plain]-^  courses                              : "course_id:id"
courses                               -[#595959,plain]-^  organizations                        : "organization_id:id"
final_quiz_attempt_answer_options     -[#595959,plain]-^  final_quiz_attempt_answers           : "attempt_answer_id:id"
final_quiz_attempt_answers            -[#595959,plain]-^  final_quiz_attempts                  : "attempt_id:id"
final_quiz_attempt_answers            -[#595959,plain]-^  questions                            : "source_question_id:id"
final_quiz_attempts                   -[#595959,plain]-^  courses                              : "course_id:id"
final_quiz_attempts                   -[#595959,plain]-^  quizzes                              : "quiz_id:id"
final_quiz_attempts                   -[#595959,plain]-^  users                                : "user_id:id"
lessons                               -[#595959,plain]-^  chapters                             : "chapter_id:id"
organization_invites                  -[#595959,plain]-^  organizations                        : "organization_id:id"
organization_invites                  -[#595959,plain]-^  users                                : "user_id:id"
organization_invites                  -[#595959,plain]-^  users                                : "invited_by:id"
organization_join_requests            -[#595959,plain]-^  organizations                        : "organization_id:id"
organization_join_requests            -[#595959,plain]-^  users                                : "reviewed_by_id:id"
organization_join_requests            -[#595959,plain]-^  users                                : "user_id:id"
organization_members                  -[#595959,plain]-^  organizations                        : "organization_id:id"
organization_members                  -[#595959,plain]-^  users                                : "user_id:id"
organizations                         -[#595959,plain]-^  users                                : "owner_id:id"
post_likes                            -[#595959,plain]-^  posts                                : "post_id:id"
post_likes                            -[#595959,plain]-^  users                                : "user_id:id"
posts                                 -[#595959,plain]-^  courses                              : "course_id:id"
posts                                 -[#595959,plain]-^  organizations                        : "organization_id:id"
posts                                 -[#595959,plain]-^  users                                : "author_id:id"
practice_quiz_attempt_answer_options  -[#595959,plain]-^  practice_quiz_attempt_answers        : "attempt_answer_id:id"
practice_quiz_attempt_answers         -[#595959,plain]-^  practice_quiz_attempts               : "attempt_id:id"
practice_quiz_attempt_answers         -[#595959,plain]-^  questions                            : "source_question_id:id"
practice_quiz_attempts                -[#595959,plain]-^  courses                              : "course_id:id"
practice_quiz_attempts                -[#595959,plain]-^  practice_quizzes                     : "practice_quiz_id:id"
practice_quiz_attempts                -[#595959,plain]-^  users                                : "user_id:id"
practice_quiz_questions               -[#595959,plain]-^  practice_quizzes                     : "practice_quiz_id:id"
practice_quiz_questions               -[#595959,plain]-^  questions                            : "question_id:id"
practice_quizzes                      -[#595959,plain]-^  courses                              : "course_id:id"
profiles                              -[#595959,plain]-^  users                                : "user_id:id"
question_options                      -[#595959,plain]-^  questions                            : "question_id:id"
questions                             -[#595959,plain]-^  courses                              : "course_id:id"
quiz_questions                        -[#595959,plain]-^  questions                            : "question_id:id"
quiz_questions                        -[#595959,plain]-^  quizzes                              : "quiz_id:id"
quizzes                               -[#595959,plain]-^  courses                              : "course_id:id"
random_quiz_attempt_question_options  -[#595959,plain]-^  random_quiz_attempt_questions        : "attempt_question_id:id"
random_quiz_attempt_questions         -[#595959,plain]-^  questions                            : "source_question_id:id"
random_quiz_attempt_questions         -[#595959,plain]-^  random_quiz_attempts                 : "attempt_id:id"
random_quiz_attempts                  -[#595959,plain]-^  courses                              : "course_id:id"
random_quiz_attempts                  -[#595959,plain]-^  users                                : "user_id:id"
xp_events                             -[#595959,plain]-^  users                                : "user_id:id"
@enduml
